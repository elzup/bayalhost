{
	admin off

	# leaf の lifetime は intermediate より短くなければならないので、先に intermediate を延ばす (既定 7d)
	pki {
		ca local {
			intermediate_lifetime 365d
		}
	}
}

# *.bayalhost は TLD 直下のワイルドカードなのでブラウザも curl も SAN として認めない。
# さらに Caddy はワイルドカードが覆う名前 (admin / dash) の個別証明書を発行しないため、
# 全ブロックを on_demand にしてアクセスされたホスト名ごとに証明書を発行させる。
# on_demand の証明書はバックグラウンド更新されずハンドシェイク時にしか更新されない。
# 既定の 12h だと寝ている間に切れ、TLS セッション再開 (証明書選択を経由しない) で
# 期限切れのままブラウザに届いて SSL エラーになるので、放置しても切れない長さにする
(local_tls) {
	tls {
		on_demand
		issuer internal {
			lifetime 90d
		}
	}
}

admin.bayalhost {
	import local_tls
	reverse_proxy 127.0.0.1:8918
}

# Worklog dashboard (pdash)。?repo=<owner>/<repo> で各リポの作業ログを描く。
# events.jsonl には仕事の QA も入るので、この Mac からの接続以外は切る。
# route で囲むのは、abort を handle より先に確実に評価させるため (既定の directive 順では後になる)
dash.bayalhost {
	import local_tls

	route {
		@remote not remote_ip 127.0.0.1/8 ::1
		abort @remote

		# /data/<host>/<owner>/<repo>/events.jsonl -> <GHQ_ROOT>/<host>/<owner>/<repo>/.metarc/log/events.jsonl
		# 配るのはこのファイルだけ。先頭 . のセグメントを弾き、リポの他の中身には届かせない。
		# GHQ_ROOT の既定値は WorkingDirectory (このリポ) の 3 階層上。ghq の <root>/<host>/<owner>/<repo> 配置が前提
		handle_path /data/* {
			@log path_regexp log ^/([A-Za-z0-9_][A-Za-z0-9._-]*)/([A-Za-z0-9_][A-Za-z0-9._-]*)/([A-Za-z0-9_][A-Za-z0-9._-]*)/events\.jsonl$
			handle @log {
				root * {$GHQ_ROOT:../../..}
				rewrite * /{re.log.1}/{re.log.2}/{re.log.3}/.metarc/log/events.jsonl
				header Cache-Control "no-store"
				file_server
			}
			handle {
				respond 404
			}
		}

		handle {
			root * {$BAYALHOST_ROOT:.}/sites/dash/current
			try_files {path} /index.html
			file_server
		}
	}
}

*.bayalhost {
	import local_tls

	# Resolved against BAYALHOST_ROOT (defaults to Caddy's working directory,
	# i.e. this repo). The launchd job sets WorkingDirectory to the repo.
	root * {$BAYALHOST_ROOT:.}/sites/{labels.1}/current
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
	}

	@env path /env.js
	header @env Cache-Control "no-store"

	# immutable はファイル名にハッシュが付くディレクトリ (Vite の /assets/、Next の /_next/static/) だけ。
	# 拡張子で一律に付けると、live 配信や deploy で中身が変わったハッシュ無しのファイルを
	# ブラウザが 1 年間使い続ける。それ以外は etag で毎回再検証させる
	@hashed path /assets/* /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@mutable not path /assets/* /_next/static/* /env.js
	header @mutable Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
