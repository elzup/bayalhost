{
	admin off
}

*.bayalhost {
	tls internal

	root * /Users/hiro/.ghq/github.com/elzup/bayalhost/sites/{labels.1}/current
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
	}

	@env path /env.js
	header @env Cache-Control "no-store"

	@static {
		path /assets/*
		path *.css
		path *.js
		path *.mjs
		path *.png
		path *.jpg
		path *.jpeg
		path *.gif
		path *.svg
		path *.webp
		path *.woff
		path *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
